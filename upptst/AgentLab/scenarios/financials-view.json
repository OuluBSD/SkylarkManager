{
  "id": "financials-view",
  "title": "The Financials site renders the ledger summary, recent entries and contracts for the finance role (read-only, no announcer writes)",
  "sites": [
    "financials"
  ],
  "agents": {
    "financer": {
      "user": "ffin",
      "role": "finance",
      "instructions": "You are ffin, a Financials finance-role viewer. Open the summary, the ledger and the contracts views. Everything is read-only.",
      "announcer": "a1"
    },
    "fviewer": {
      "user": "fviewer",
      "role": "viewer",
      "instructions": "You are fviewer, a Financials viewer without the finance role. The summary renders; the ledger and the contracts are refused. Announce each refusal on AgentIPC with @scenario-oversight.",
      "announcer": "a2"
    }
  },
  "provision": {
    "financials": [
      {
        "user": "ffin",
        "role": "finance"
      },
      {
        "user": "fviewer",
        "role": "viewer"
      }
    ]
  },
  "steps": [
    {
      "id": "fin-login",
      "as": "financer",
      "login": "financials"
    },
    {
      "id": "summary",
      "as": "financer",
      "describe": "the ledger summary renders",
      "run": [
        "financials",
        "financials-summary"
      ],
      "expect": {
        "rc": 0,
        "contains": [
          "Financials summary"
        ]
      }
    },
    {
      "id": "ledger",
      "as": "financer",
      "describe": "the recent ledger entries render",
      "run": [
        "financials",
        "financials-ledger"
      ],
      "expect": {
        "rc": 0
      }
    },
    {
      "id": "contracts",
      "as": "financer",
      "describe": "the contracts render",
      "run": [
        "financials",
        "financials-contracts"
      ],
      "expect": {
        "rc": 0
      },
      "announce": "@scenario-oversight financials views rendered"
    },
    {
      "id": "fviewer-login",
      "as": "fviewer",
      "login": "financials"
    },
    {
      "id": "fviewer-summary",
      "as": "fviewer",
      "describe": "a viewer without the finance role sees the summary",
      "run": [
        "financials",
        "financials-summary"
      ],
      "expect": {
        "rc": 0,
        "contains": [
          "Financials summary"
        ]
      }
    },
    {
      "id": "fviewer-ledger-refused",
      "as": "fviewer",
      "describe": "a viewer without the finance role cannot open the ledger (role negative)",
      "run": [
        "financials",
        "financials-ledger"
      ],
      "expect": {
        "rc": 1
      },
      "announce": "@scenario-oversight ledger refused for viewer"
    },
    {
      "id": "fviewer-contracts-refused",
      "as": "fviewer",
      "describe": "a viewer without the finance role cannot open the contracts (role negative)",
      "run": [
        "financials",
        "financials-contracts"
      ],
      "expect": {
        "rc": 1
      },
      "announce": "@scenario-oversight contracts refused for viewer"
    }
  ]
}
