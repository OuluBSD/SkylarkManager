public:
	String Id() const override { return "cycle-two"; }
	String Title() const override { return "Cycle two"; }
	int DefaultPort() const override { return 18306; }
	Vector<String> Requires() const override { Vector<String> r; r.Add("cycle-one"); return r; }
};

