#include <WebAppHost/WebAppHost.h>

NAMESPACE_UPP

Vector<String>& WebAppTestLog()
{
	static Vector<String> log;
	return log;
}

class TestWebApp : public WebApp {
public:
	bool Install(EngineSite& site, WebAppContext& ctx, String& error) override {
		if(!ctx.grants || !ctx.broker)
			WebAppTestLog().Add("missing-context");
		WebAppTestLog().Add(Id());
		return true;
	}
};

class AlphaApp : public TestWebApp {
public:
	String Id() const override { return "alpha"; }
	String Title() const override { return "Alpha"; }
	int DefaultPort() const override { return 18301; }
	Vector<String> Roles() const override { Vector<String> r; r.Add("viewer"); r.Add("admin"); return r; }
};

class BetaApp : public TestWebApp {
public:
	String Id() const override { return "beta"; }
	String Title() const override { return "Beta"; }
	int DefaultPort() const override { return 18302; }
	Vector<String> Requires() const override { Vector<String> r; r.Add("alpha"); return r; }
};

class GammaApp : public TestWebApp {
public:
	String Id() const override { return "gamma"; }
	String Title() const override { return "Gamma"; }
	int DefaultPort() const override { return 18303; }
	Vector<String> Requires() const override { Vector<String> r; r.Add("beta"); return r; }
};

class ZetaApp : public TestWebApp {
public:
	String Id() const override { return "zeta"; }
	String Title() const override { return "Zeta"; }
	int DefaultPort() const override { return 18304; }
};

