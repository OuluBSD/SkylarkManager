<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;">
  <div>
    <a href="$base?tab=agents" class="wf-btn wf-btn-secondary" style="font-size:0.8rem; display:inline-flex; align-items:center; gap:6px;">$raw(icon_arrow_left) Back to Agent Runs</a>
  </div>
  <div style="display:flex; gap:8px;">
    <button type="button" id="btn-agent-apply-patch" class="wf-btn wf-btn-primary" style="background:var(--wf-color-positive,#00aa7f); border-color:var(--wf-color-positive,#00aa7f); display:inline-flex; align-items:center; gap:6px; font-weight:600;" onclick="AgentPlatformUI.applyPatch('$raw(js_owner)', '$raw(js_repo)', '$raw(js_run_id)')">$raw(icon_check) Apply to Branch</button>
    <button type="button" id="btn-agent-create-pr" class="wf-btn wf-btn-primary" style="background:#8957e5; border-color:#8957e5; display:inline-flex; align-items:center; gap:6px; font-weight:600;" onclick="AgentPlatformUI.createPr('$raw(js_owner)', '$raw(js_repo)', '$raw(js_run_id)')">$raw(icon_pr) Create Pull Request</button>
  </div>
</div>
<div class="wf-card" style="margin-bottom:1.5rem;">
  <div class="wf-card-header">
    <div style="display:flex; align-items:center; gap:10px;">
      <span style="font-size:1.15rem; font-weight:700;">$run_id</span>
      <span class="wf-badge wf-badge-$status_class">$status_label</span>
      <span style="color:var(--wf-fg-inactive,#8b919d); font-size:0.85rem;">&middot; Model: <strong>$model</strong></span>
      <span style="color:var(--wf-fg-inactive,#8b919d); font-size:0.85rem;">&middot; Branch: <code>$branch</code></span>
$if(has_issue)      <span style="color:var(--wf-fg-inactive,#8b919d); font-size:0.85rem;">&middot; Linked: <a href="$issue_url" style="color:var(--wf-accent-link,#00acd3); font-weight:600;">#$linked_issue</a></span>
$endif    </div>
    <span style="color:var(--wf-fg-inactive,#8b919d); font-size:0.85rem;">Duration: $duration</span>
  </div>
  <div class="wf-card-body">
    <div style="font-weight:600; font-size:1rem; margin-bottom:6px;">Task Prompt</div>
    <div style="background:var(--wf-surface,#161b22); border-left:3px solid var(--wf-color-positive,#00aa7f); padding:10px 14px; border-radius:0 6px 6px 0; font-size:0.9rem;">$task_prompt</div>
  </div>
</div>
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
  <h3 style="margin:0;">Autonomous Execution Trajectory ($step_count Steps)</h3>
  <span class="wf-badge wf-badge-neutral">ReAct Loop</span>
</div>
$for(s in steps)<div class="wf-card" style="margin-bottom:1rem;">
  <div class="wf-card-header" style="background:rgba(255,255,255,0.02);">
    <div style="display:flex; align-items:center; gap:8px;">
      <span class="wf-badge wf-badge-neutral" style="font-weight:700;">Step $s.index</span>
      <span style="font-size:0.85rem; color:var(--wf-fg-inactive,#8b919d);">$s.timestamp</span>
    </div>
    <span class="wf-badge wf-badge-cyan">$s.tool_name</span>
  </div>
  <div class="wf-card-body" style="display:flex; flex-direction:column; gap:10px;">
    <div id="agent-step-thought" style="background:rgba(0,161,197,0.08); border-left:3px solid #00a1c5; padding:8px 12px; border-radius:0 4px 4px 0; font-size:0.88rem;">
      <strong style="color:#7dd3fc;">Thought:</strong> $s.thought
    </div>
    <div id="agent-step-tool">
      <div style="font-size:0.75rem; font-weight:600; color:var(--wf-fg-inactive,#8b919d); margin-bottom:2px;">ACTION &bull; $s.tool_upper</div>
      <div style="background:var(--wf-bg-view,#0d1117); padding:8px 12px; border-radius:4px; font-family:monospace; font-size:0.82rem; border:1px solid var(--wf-border-color,#30363d); color:#7ee787;">$s.tool_args</div>
    </div>
    <div id="agent-step-obs">
      <div style="font-size:0.75rem; font-weight:600; color:var(--wf-fg-inactive,#8b919d); margin-bottom:2px;">OBSERVATION</div>
      <pre style="background:var(--wf-bg-view,#0d1117); padding:8px 12px; border-radius:4px; font-family:monospace; font-size:0.82rem; border:1px solid var(--wf-border-color,#30363d); margin:0; white-space:pre-wrap; color:var(--wf-fg-normal,#e6e8eb);">$s.observation</pre>
    </div>
  </div>
</div>
$endfor$raw(patch_html)