<div class="wf-card">
  <div class="wf-card-header"><span>Security Overview</span><span class="wf-badge wf-badge-neutral">Not loaded</span></div>
  <div class="wf-card-body">
    <p style="font-size:0.85rem; color:var(--wf-fg-inactive,#7d8590); margin:0 0 16px 0;">This view does not read GitHub security data, so nothing below has been checked.</p>
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:16px;">
      <div style="background:var(--wf-surface,#161b22); padding:16px; border-radius:6px; border:1px solid var(--wf-border-color,#30363d);">
        <h4>Dependabot Alerts</h4>
        <div style="font-size:1.8rem; font-weight:700; color:var(--wf-fg-inactive,#7d8590);">Not loaded</div>
        <p style="font-size:0.8rem; color:var(--wf-fg-inactive,#7d8590); margin:0;">Dependency alerts are not read by this view.</p>
      </div>
      <div style="background:var(--wf-surface,#161b22); padding:16px; border-radius:6px; border:1px solid var(--wf-border-color,#30363d);">
        <h4>Secret Scanning</h4>
        <div style="font-size:1.8rem; font-weight:700; color:var(--wf-fg-inactive,#7d8590);">Not performed</div>
        <p style="font-size:0.8rem; color:var(--wf-fg-inactive,#7d8590); margin:0;">Secret scan: not performed.</p>
      </div>
      <div style="background:var(--wf-surface,#161b22); padding:16px; border-radius:6px; border:1px solid var(--wf-border-color,#30363d);">
        <h4>Code Scanning</h4>
        <div style="font-size:1.8rem; font-weight:700; color:var(--wf-fg-inactive,#7d8590);">Not loaded</div>
        <p style="font-size:0.8rem; color:var(--wf-fg-inactive,#7d8590); margin:0;">Code scanning results are not read by this view.</p>
      </div>
    </div>
  </div>
</div>
