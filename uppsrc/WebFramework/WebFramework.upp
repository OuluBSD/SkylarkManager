description "Reusable Skylark web framework with templates, KDE Plasma themes, scalable mega-menu, and density control\377";

uses
	Core,
	Skylark;

file
	AGENTS.md,
	deploy-assets.sh,
	Assets readonly separator,
	Assets.h,
	Assets.cpp,
	WebFramework.h,
	Navigation.h,
	Navigation.cpp,
	Tree.h,
	Tree.cpp,
	Icons.h,
	Icons.cpp,
	Audio.h,
	Audio.cpp,
	Theme.h,
	Theme.cpp,
	Template.h,
	Template.cpp,
	PageBuilder.h,
	PageBuilder.cpp,

	Styles readonly separator,
	assets/base-components.css,
	assets/density.css,
	assets/megamenu.css,
	assets/template-appworkspace.css,
	assets/template-dashboard.css,
	assets/template-github.css,
	assets/template-megamenu.css,
	assets/template-sidebar.css,
	assets/template-sourceforge.css,
	assets/tree.css,

	Scripts readonly separator,
	assets/audio.js,
	assets/density.js,
	assets/megamenu.js,
	assets/theme.js,
	assets/tree.js;
