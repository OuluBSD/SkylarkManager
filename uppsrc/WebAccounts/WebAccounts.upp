description "Instance-scoped account layer for fenced websites: per-site users, site-stamped sessions, server-side CSRF tokens, TOTP second factor, consent grants\377";

uses
	Core,
	Core/SSL,
	WebAuth,
	WebStorage;

file
	AGENTS.md,
	Core readonly separator,
	WebAccounts.h,
	WebAccounts.cpp,
	Totp readonly separator,
	WebAccountsTotp.h,
	WebAccountsTotp.cpp,
	Grants readonly separator,
	WebAccountsGrants.h,
	WebAccountsGrants.cpp;
