<div class="wf-card">
  <div class="wf-card-header"><span>Commit History &middot; $branch</span><span class="wf-badge wf-badge-neutral">$count commits</span></div>
  <div class="wf-card-body" style="padding:0;">
    <div class="wf-gh-file-box" style="border:none; margin:0;">
$for(c in commits)      <div class="wf-gh-file-row" style="justify-content:space-between; padding:12px 16px;">
        <div>
          <div style="font-weight:600; color:var(--wf-fg-normal,#ffffff); font-size:0.92rem;">$c.msg</div>
          <div style="font-size:0.8rem; color:var(--wf-fg-inactive,#7d8590); margin-top:4px;">            <strong>$c.author</strong> committed $c.time
          </div>
        </div>
        <div>
          <code style="background:var(--wf-bg-view,#0d1117); border:1px solid var(--wf-border-color,#30363d); padding:3px 8px; border-radius:4px;">$c.hash</code>
        </div>
      </div>
$endfor    </div>
  </div>
</div>
