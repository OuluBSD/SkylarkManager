<div id="agent-patch-card" class="wf-card" style="margin-top:1.5rem;">
  <div class="wf-card-header">
    <span>$raw(icon_commit) Generated Code Patch Diff</span>
    <span class="wf-badge wf-badge-emerald">Ready to Apply</span>
  </div>
  <div class="wf-card-body" style="padding:0;">
$raw(diff_html)  </div>
</div>
