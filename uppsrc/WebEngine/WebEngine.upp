description "Composable website engine: fenced virtual websites with per-site accounts, sessions, cookies, storage and routers inside one Skylark process\377";

uses
	Core,
	Skylark,
	WebStorage,
	WebBroker,
	WebAccounts,
	WebAuth;

file
	AGENTS.md,
	WebEngine.h,
	Model readonly separator,
	Router.h,
	Router.cpp,
	ContentPolicy.h,
	ContentPolicy.cpp,
	ContentPolicyRoutes.cpp,
	Site.h,
	Site.cpp,
	Request.h,
	Request.cpp,
	Manifest.h,
	Manifest.cpp,
	Engine readonly separator,
	Engine.h,
	WebEngine.cpp,
	SessionRoutes.h,
	SessionRoutes.cpp,
	CommandConsole.h,
	CommandConsole.cpp,
	Host readonly separator,
	Host.h,
	Host.cpp;
